{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-5",

  // Restores the todo tool OpenCode V2 removed.
  //
  // review.md queues requested fixes with `todowrite` so they outlive the user
  // switching to build mode, but V2 dropped `todowrite` and `todoread` from the
  // runtime: the installed 2.0.12 binary has no such tool, there is no
  // /api/todo endpoint, and the docs list neither the tool nor an action for
  // it. Upstream closed the tracking issue (anomalyco/opencode#42421) as "not
  // planned", and v2.0.18 still ships without it, so updating does not bring it
  // back. The plugin re-registers `todowrite` and re-injects the current list
  // each round, which is what makes the queue visible again after a mode
  // switch.
  //
  // Vendored rather than installed from npm. The published 0.2.1 ships its
  // sidebar as raw JSX (src/tui.tsx) with `tui: true`, and 2.0.12 compiles JSX
  // with Bun's default React transform whenever the file sits under
  // node_modules -- its Solid transform skips those paths. So the npm install
  // always fails the TUI half with "Cannot find package 'react'". There is no
  // way to keep the tool and drop only the TUI half: the `-opencode2.todo.tui`
  // disable directive is not honoured for TUI plugins, `enabled: false` removes
  // the tool as well, and 2.0.12 rejects a file path in `plugins` -- it wants a
  // directory. The copy in plugins/opencode2-todo/ is the server half only, so
  // the sidebar is never requested; see its README for the two-line change. It
  // loads from outside node_modules and needs no node_modules of its own.
  //
  // It is someone else's package, and its upstream repo is archived, so treat
  // it as a stopgap: if OpenCode ships the tool again, delete plugins/ and this
  // entry and nothing else changes.
  "plugins": ["./plugins/opencode2-todo"],

  // Appended to every agent's context. "instructions" is documented as
  // additive, unlike an agent's "prompt", which does not say whether it
  // replaces a built-in agent's own prompt -- not worth finding out on build
  // mode.
  //
  // The path must be "~/"-anchored. A plain "comments.md" here resolves
  // against the *project*, not against this file, so it silently loaded
  // nothing outside this repo -- checked with a sentinel, since a missing
  // instruction file is not reported. install.sh links opencode/ to
  // ~/.config/opencode, so this still points at the repo's own copy on any
  // machine.
  "instructions": ["~/.config/opencode/comments.md"],

  // No mode may touch git history without a decision from you.
  //
  // Commits belong to the `commit` agent: it plans the split, shows it as a
  // table and commits only once you agree. build and plan therefore *deny*
  // `git commit` rather than ask -- the answer to "commit this" is to switch
  // agent, not to approve a prompt at the last moment. The commit agent
  // allows it outright, because that table is the approval.
  //
  // Everything else that moves a ref, rewrites what is already recorded, or
  // publishes it is gated below. Reading history is untouched: log, show,
  // diff, status, blame, describe, rev-parse and fetch all stay silent, so an
  // agent can still orient itself without asking.
  //
  // For those, "ask" rather than "deny", because the point is that *you*
  // decide, not that it becomes impossible. An explicit "push this" then
  // costs one confirmation, while an agent that decided to tidy up after
  // itself gets stopped. (agent/review.md denies the whole list, because that
  // agent is read-only by construction and has no business committing or
  // pushing even when asked.)
  //
  // Patterns lead with "*" because a bash rule is matched against the whole
  // command line: a bare "git commit -m x" and a chained
  // "cd sub && git commit -m x" both have to match, and a leading wildcard
  // catches both (verified -- "*" matches the empty string, so the leading
  // form covers the unchained case too and no second pattern is needed).
  //
  // These live on each agent rather than at the top level on purpose. Rules
  // are evaluated in order with the last match winning, and an agent's rules
  // are appended after a project's -- so a top-level rule here would be
  // silently overridden by any project whose own config says
  // bash "*": "allow", which is common. On an agent they always land last.
  //
  // Note there is no "*": "allow" in either block. That would land after a
  // project's rules too, and would re-permit anything the project had
  // denied. opencode already allows bash by default, so leaving it out costs
  // nothing and keeps project denials intact.
  //
  // The list is written out once per agent because the config format has no
  // way to share it -- no anchors, no includes -- and a plugin that injected
  // it would be one silent failure away from removing the guard entirely,
  // which is the whole thing being guarded against. Copies that must stay in
  // step are a liability, so tests/test_opencode_agents.sh fails if build,
  // plan, review and commit ever drift from the action each is meant to have.
  "agent": {
    "build": {
      "permission": {
        "bash": {
          // Commits are the `commit` agent's job, refused here rather than
          // asked so build cannot commit by approving a prompt.
          "*git commit*": "deny",

          // Publishes a commit.
          "*git push*": "ask",
          "*git pull*": "ask",
          "*git merge*": "ask",
          "*git am*": "ask",
          "*git cherry-pick*": "ask",
          "*git revert*": "ask",

          // Rewrites or discards what is already recorded.
          "*git rebase*": "ask",
          "*git reset*": "ask",
          "*git filter-branch*": "ask",
          "*git filter-repo*": "ask",
          "*git replace*": "ask",

          // Moves refs, or drops the means of recovering them.
          "*git update-ref*": "ask",
          "*git tag*": "ask",
          "*git branch -d*": "ask",
          "*git branch -D*": "ask",
          "*git branch --delete*": "ask",
          "*git reflog*": "ask",
          "*git gc*": "ask",
          "*git prune*": "ask",

          // Not history as such, but it commits to refs/stash and `drop`
          // and `clear` lose work outright.
          "*git stash*": "ask"
        }
      }
    },

    // Identical to build. Plan mode already refuses to edit files, but bash
    // is open to it, so without this it could commit what build had just been
    // stopped from committing -- the guard has to be on every mode that can
    // reach a shell or it is only a speed bump.
    "plan": {
      "permission": {
        "bash": {
          // As build: commits go through the `commit` agent.
          "*git commit*": "deny",
          "*git push*": "ask",
          "*git pull*": "ask",
          "*git merge*": "ask",
          "*git am*": "ask",
          "*git cherry-pick*": "ask",
          "*git revert*": "ask",

          "*git rebase*": "ask",
          "*git reset*": "ask",
          "*git filter-branch*": "ask",
          "*git filter-repo*": "ask",
          "*git replace*": "ask",

          "*git update-ref*": "ask",
          "*git tag*": "ask",
          "*git branch -d*": "ask",
          "*git branch -D*": "ask",
          "*git branch --delete*": "ask",
          "*git reflog*": "ask",
          "*git gc*": "ask",
          "*git prune*": "ask",

          "*git stash*": "ask"
        }
      }
    }
  }
}
