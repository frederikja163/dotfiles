#!/usr/bin/env bash
# Point this desktop at a git worktree, or any directory under it.
#
# Lists the worktrees of whatever repository the desktop is currently in, so a
# desktop can be moved between branches without leaving it. Picking one sets the
# desktop's directory; the dropdown terminal restarts there.
set -uo pipefail

dir="$(desk-dir)"

worktrees() {
    git -C "$dir" worktree list --porcelain 2>/dev/null |
        sed -n 's/^worktree //p'
}

list="$(worktrees)"
if [ -z "$list" ]; then
    notify-send "desk-worktree" "$dir is not in a git repository" 2>/dev/null
    exit 1
fi

choice="$(printf '%s\n' "$list" | fuzzel --dmenu --prompt "worktree  " --width 60 --no-icons)" || exit 0
[ -n "$choice" ] && [ -d "$choice" ] || exit 0

desk-dir --set "$choice"

# The dropdown terminal is still sitting in the old directory, so replace it.
id="$(desk-dir --id)"
addr="$(hyprctl clients -j 2>/dev/null | python3 -c "
import json, sys
want = 'quake-' + sys.argv[1]
for w in json.load(sys.stdin):
    if w.get('class') == want:
        print(w['address']); break
" "$id")"

if [ -n "$addr" ]; then
    hyprctl dispatch "hl.dsp.window.close({ window = \"address:$addr\" })" >/dev/null 2>&1
fi

notify-send "desktop $id" "now on $(basename "$choice")" 2>/dev/null
