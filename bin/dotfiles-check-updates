#!/usr/bin/env bash
# Say, once per login, if this repo has commits waiting on the remote.
#
# Started from hypr/autostart.lua. It is a reminder, not a sync: nothing is
# pulled, because pulling relinks configs under a running session and that is a
# decision to take deliberately rather than at login.
#
# Silent unless there is something to say. On a detached HEAD, on a branch with
# no upstream, or with the remote still unreachable when it gives up, it exits
# without a word -- a notification that fires whenever the wifi is slow is one
# that gets ignored.
set -uo pipefail

# The repo is wherever this script really lives: bin/ is a symlink from
# ~/.local/bin, so the link has to be resolved before taking the parent.
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)" || exit 1

# shellcheck source=lib/dotfiles-lib.sh
. "$REPO/lib/dotfiles-lib.sh" || exit 1

# The session is up before the network is. Overridable so the tests do not wait.
sleep "${DOTFILES_CHECK_UPDATES_DELAY:-30}"

# ...and a single delay was not enough. Waiting 30 seconds and giving up assumed
# the network arrives shortly after the session, which is true of wifi that
# reconnects on its own and false of every other case: opening the laptop out of
# range, a captive portal, or picking the network by hand a few minutes in. The
# check then stayed silent for the whole login even though there were commits
# waiting, which is the one failure the reminder cannot afford -- it is the only
# thing that ever tells you.
#
# So the fetch below is retried on a schedule instead, and only the last failure
# is silent. Every attempt is a full fetch: there is no cheap way to ask "is the
# network up" that is worth trusting, since a route and a DNS answer both exist
# on a captive portal that will not pass a git fetch through.
#
# Half an hour is where it stops. That is long enough to cover coming back into
# range or logging into a portal, and short enough that the notification still
# belongs to this login rather than arriving out of nowhere hours later.
# Short locals below, because the override names are a mouthful in an
# expression and the environment is only how a test reaches in.
retry_interval="${DOTFILES_CHECK_UPDATES_RETRY_INTERVAL:-120}"
retry_deadline="${DOTFILES_CHECK_UPDATES_RETRY_DEADLINE:-1800}"

cd "$REPO" || exit 1

# Nothing may ask a question: there is no terminal to answer at, and a prompt
# would hang this script for the rest of the session.
export GIT_TERMINAL_PROMPT=0

branch="$(git symbolic-ref --quiet --short HEAD)" || exit 0
remote="$(git config "branch.$branch.remote")" || exit 0
merge="$(git config "branch.$branch.merge")" || exit 0

# Over https rather than the configured ssh url: see the reasoning in
# dotfiles-lib.sh. It matters more here than in dotfiles-update, because the
# "stay quiet on failure" rule above would hide an ssh failure forever.
url="$(git remote get-url "$remote" 2>/dev/null)" || exit 0
url="$(dotfiles_https_url "$url")"

# Failures are not told apart by cause, deliberately: git reports "could not
# resolve host" and a remote that has genuinely gone away with the same exit
# status, so every failure is treated as worth another try. Retrying a real
# error costs a fetch every two minutes and then silence, which is what would
# have happened immediately anyway.
started=$SECONDS
while :; do
    timeout 60 git fetch --quiet "$url" "$merge" 2>/dev/null && break
    [ "$((SECONDS - started))" -lt "$retry_deadline" ] || exit 0
    sleep "$retry_interval"
done

behind="$(git rev-list --count "HEAD..FETCH_HEAD" 2>/dev/null)" || exit 0
[ "${behind:-0}" -gt 0 ] || exit 0

if [ "$behind" -eq 1 ]; then
    summary="dotfiles: 1 commit behind"
else
    summary="dotfiles: $behind commits behind"
fi

# --app-name is what dunst matches its rule on, see dunst/dunstrc.
notify-send \
    --app-name=dotfiles \
    --urgency=normal \
    "$summary" \
    "$remote has changes. Pull in $REPO when convenient."
