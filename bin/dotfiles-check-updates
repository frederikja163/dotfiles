#!/usr/bin/env bash
# Say, once per login, if this repo has commits waiting on the remote.
#
# Started from hypr/autostart.lua. It is a reminder, not a sync: nothing is
# pulled, because pulling relinks configs under a running session and that is a
# decision to take deliberately rather than at login.
#
# Silent when there is nothing to say: on a detached HEAD, on a branch with no
# upstream, or when the fetch succeeds and the branch is already current.
#
# Not silent about being offline, which is a deliberate reversal. It used to
# stay quiet on a failed fetch on the grounds that a notification firing
# whenever the wifi is slow gets ignored -- but the cost of that was a login
# where the machine never got online and the reminder simply never arrived, and
# nothing ever said so. Now it says so, once, and keeps trying.
set -uo pipefail

# The repo is wherever this script really lives: bin/ is a symlink from
# ~/.local/bin, so the link has to be resolved before taking the parent.
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)" || exit 1

# shellcheck source=lib/dotfiles-lib.sh
. "$REPO/lib/dotfiles-lib.sh" || exit 1

# The first fetch happens immediately, with no delay in front of it.
#
# There was a 30 second sleep here, on the grounds that the session comes up
# before the network does. That is true at login and wrong everywhere else: run
# by hand, on a machine that is already online, the script sat there for half a
# minute before answering a question it could have answered at once.
#
# Every attempt is a full fetch. There is no cheap way to ask "is the network
# up" that is worth trusting, because a route and a DNS answer both exist on a
# captive portal that will not pass a git fetch through.
#
# Short locals, because the override names are a mouthful inside an expression
# and the environment is only how a test reaches in.
retry_interval="${DOTFILES_CHECK_UPDATES_RETRY_INTERVAL:-30}"

cd "$REPO" || exit 1

# Nothing may ask a question: there is no terminal to answer at, and a prompt
# would hang this script for the rest of the session.
export GIT_TERMINAL_PROMPT=0

branch="$(git symbolic-ref --quiet --short HEAD)" || exit 0
remote="$(git config "branch.$branch.remote")" || exit 0
merge="$(git config "branch.$branch.merge")" || exit 0

# Over https rather than the configured ssh url: see the reasoning in
# dotfiles-lib.sh. It matters more here than in dotfiles-update, because an ssh
# fetch would fail every time and this script would then blame the network.
url="$(git remote get-url "$remote" 2>/dev/null)" || exit 0
url="$(dotfiles_https_url "$url")"

# Notifications go out under one app name, which is what dunst matches its rule
# on (see dunst/dunstrc: it gives these no timeout, so they wait to be
# dismissed rather than expiring while you look elsewhere).
notify() {
    notify-send --app-name=dotfiles --urgency=normal --print-id "$@" 2>/dev/null
}

# Recalling one needs the bus directly; notify-send can create and replace but
# not close. busctl rather than gdbus deliberately: it comes with systemd, which
# is definitionally installed, where gdbus would mean declaring glib2 in
# packages/pacman.txt for one call.
unnotify() {
    busctl --user call org.freedesktop.Notifications \
        /org/freedesktop/Notifications org.freedesktop.Notifications \
        CloseNotification u "$1" >/dev/null 2>&1
}

# Failures are not told apart by cause, deliberately: git reports "could not
# resolve host" and a remote that has genuinely gone away with the same exit
# status. Every failure is treated as the network, which is what it almost
# always is -- see the note on the wording below.
#
# There is no deadline. Retrying stops when the fetch works or the session ends,
# because a reminder that gives up while you are still logged in is a reminder
# that silently stopped watching.
offline_id=""
failures=0

while :; do
    if timeout 60 git fetch --quiet "$url" "$merge" 2>/dev/null; then
        break
    fi

    failures=$((failures + 1))

    # Said after the second failure, not the first: one failed fetch at login is
    # the ordinary case, because the session really is up before the network.
    # Waiting for a second one 30 seconds later is what distinguishes "still
    # connecting" from "not going to connect on its own".
    #
    # Worded as a reminder rather than a diagnosis. If the real cause is a bad
    # remote url or a deleted repo, this says the wrong thing -- but git gives
    # the same exit status either way, and of the two the network is the one
    # that happens.
    if [ "$failures" -eq 2 ]; then
        offline_summary="dotfiles: cannot reach the remote"
        offline_body="Remember to get on the internet."
        offline_body="$offline_body Still checking every ${retry_interval}s."
        offline_id="$(notify "$offline_summary" "$offline_body")"
    fi

    sleep "$retry_interval"
done

behind="$(git rev-list --count "HEAD..FETCH_HEAD" 2>/dev/null)" || exit 0

# The offline notice has no timeout, so it sits there until something takes it
# away. Reaching here means it is answered either way: replaced by the real
# reminder if there is one, closed if there is nothing to report. Leaving it up
# would have it telling you to get online from then on, while you are online.
if [ "${behind:-0}" -le 0 ]; then
    [ -n "$offline_id" ] && unnotify "$offline_id"
    exit 0
fi

if [ "$behind" -eq 1 ]; then
    summary="dotfiles: 1 commit behind"
else
    summary="dotfiles: $behind commits behind"
fi

body="$remote has changes. Pull in $REPO when convenient."

if [ -n "$offline_id" ]; then
    notify --replace-id="$offline_id" "$summary" "$body" >/dev/null
else
    notify "$summary" "$body" >/dev/null
fi
