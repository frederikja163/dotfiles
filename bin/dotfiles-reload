#!/usr/bin/env bash
# Apply the dotfiles to the running session: hyprctl reload, then everything a
# reload leaves behind.
#
# hyprctl reload re-reads hypr/ (the Lua modules, monitors placement,
# windowrules, keybinds) and re-applies the PATH environment.lua exports to
# processes started afterwards. What it cannot touch lives outside the
# compositor: waybar keeps its own config and process, hyprpaper and hypridle
# read their conf only once at startup, dunst has its own daemon. So one
# command here is the full "I edited something, put it live" step; nothing is
# left to remember.
#
# hyprlock is not here on purpose: it has no daemon, the next lock reads
# hyprlock.conf fresh. And nothing covers a kernel-ish change to PATH exports
# -- prestidigitation there wants a proper session restart, this only re-feeds
# the exports to new processes.
#
# Two cautions about the world this runs in.
#
# In the sandbox (HYPR_SANDBOX=1) anything hyprctl touches is the *host*
# session, so asking it to reload here would rearrange the desktop the user is
# sitting in. Same reason bin/waybar-main spawns nothing while nested: this
# refuses to run at all when the marker is set.
#
# The daemons are restarted only if they are already running, and killed by
# pid rather than pkill, so a user who stopped hypridle (or a process whose
# name matched a pattern) does not find it back on at the next reload.
#
# The work itself runs detached: waybar lives as long as the session, and
# waiting on it would hold the shell's prompt until the next reboot. This
# returns the moment the jobs are launched, and each step that fails raises a
# notification on its own -- there is no waybar to hold the screen output
# after the shell has its prompt back.
set -uo pipefail

# Takes no arguments, and says so rather than ignoring them.
#
# Ignoring them was the original behaviour and it is a trap: this script's whole
# job is to act on the session you are sitting in, so `dotfiles-reload --help`
# from someone expecting a usage message restarted their bar, wallpaper and idle
# daemon and dropped every desktop's column layout instead. Anything that only
# ever does something had better refuse what it does not understand.
if [ $# -gt 0 ]; then
    printf 'dotfiles-reload: takes no arguments (got %s)\n' "$*" >&2
    printf 'It applies hypr/, waybar/, hyprpaper, hypridle and dunst to the\n' >&2
    printf 'running session. There is nothing to configure; just run it bare.\n' >&2
    exit 2
fi

if [ "${HYPR_SANDBOX:-}" = "1" ]; then
    printf 'dotfiles-reload: refusing to run inside the sandbox (would reload the host session)\n' >&2
    exit 1
fi

for c in hyprctl waybar-main dunstctl notify-send; do
    command -v "$c" >/dev/null || {
        printf 'dotfiles-reload: %s is not on PATH\n' "$c" >&2
        notify-send "dotfiles-reload" "$c missing" 2>/dev/null
        exit 1
    }
done

# A config that is only read at startup: restart the daemon -- if it is
# running at all -- so the edited conf gets read. Kill whichever pids
# pgrep finds and start it again, detached so it outlives this shell.
restart_if_running() {
    local name="$1" pids pid
    pids="$(pgrep -x "$name")" || return 0
    for pid in $pids; do
        kill "$pid" 2>/dev/null || true
    done
    sleep 0.2
    if ! command -v "$name" >/dev/null; then
        return 1
    fi
    nohup "$name" >>/dev/null 2>&1 &
    return 0
}

# waybar cannot go through step() the way the others do.
#
# bin/waybar-main ends in `exec waybar`, so it does not return while the bar is
# up -- it *is* the bar. Handing it to step(), which waits for its command and
# reads the exit status, parked this script on it for the rest of the session:
# every reload left a dotfiles-reload process holding a waybar and never ran the
# hyprpaper, hypridle or dunst steps below at all. Then the next reload's
# `pkill -x waybar` killed the parked run's bar, it exited non-zero, and that
# stale process announced "failed: waybar" about a bar that had worked
# perfectly. Five of those were sitting in dunst's history.
#
# waybar-main is right to exec: its other two callers, autostart.lua and
# deskbinds.lua, want a process that stays. So the caller is what changes here.
# Start it detached, and report on whether the bar came back rather than on an
# exit status that only arrives when something kills it.
start_waybar() {
    local before pid i

    # The pids to ignore while waiting. waybar-main kills the old bar and sleeps
    # before starting the new one, so checking for "a waybar exists" straight
    # away would find the outgoing one and call it a success.
    before=" $(pgrep -x waybar | tr '\n' ' ') "

    nohup waybar-main >/dev/null 2>&1 &

    # Twenty quarter-second checks: five seconds of waiting, six or so in wall
    # time once pgrep is counted. Generously more than the 0.3s wait inside
    # waybar-main plus the time waybar needs to map its layer surfaces, and it
    # only ever runs that long when the bar genuinely does not come back.
    for ((i = 0; i < 20; i++)); do
        sleep 0.25
        for pid in $(pgrep -x waybar); do
            case "$before" in
                *" $pid "*) ;;
                *) return 0 ;;
            esac
        done
    done

    return 1
}

(
    step() {
        local label="$1"; shift
        if "$@"; then
            return 0
        fi
        notify-send "dotfiles-reload" "failed: $label" 2>/dev/null
    }

    step "hyprland"  hyprctl reload
    step "waybar"    start_waybar
    step "hyprpaper" restart_if_running hyprpaper
    step "hypridle"  restart_if_running hypridle

    # dunst is started with the session now (see autostart.lua), so it should be
    # running -- but the guard stays, because a reload is not the place to
    # resurrect it and a stopped daemon is not a failure of this script.
    if pgrep -x dunst >/dev/null; then
        step "dunst" dunstctl reload
    fi
) >/dev/null 2>&1 &

exit 0