#!/usr/bin/env bash
# Extract zip archives into the current directory, for yazi's Enter key.
#
# yazi's stock "extract" opener publishes to its built-in extract plugin, which
# shells out to `7zz` or `7z` and reports "Do you have 7-zip installed?" when
# neither is there. This machine has `unzip` and not 7-zip, so zips are opened
# with this instead; see yazi/yazi.toml for the rule that routes them here.
#
# A script rather than a shell one-liner in the opener, for three reasons.
#
# `unzip a.zip b.zip` does not extract two archives: everything after the first
# is read as a *member pattern* inside it, so selecting two zips and pressing
# Enter lists zero files and exits 11, having done nothing. Whatever runs this
# has to loop, one archive per invocation of unzip.
#
# Without -n, unzip prompts before overwriting. An opener runs with no terminal
# on stdin, so the prompt reads EOF, prints "(EOF or read error, treating as
# [N]one)" where nobody sees it, and exits 1 part-way through.
#
# And the opener string is scanned by yazi for %s-style placeholders before it
# reaches a shell, so shell parameter expansions like ${f%.*} in there are
# relying on that scanner to leave them alone. Passing plain arguments avoids
# the question.
#
# Errors go to notify-send as well as stderr: yazi discards an opener's output,
# so without it a failed extract is indistinguishable from nothing happening.
set -uo pipefail

if [ $# -eq 0 ]; then
    printf 'unzip-here: no archive given\n' >&2
    printf 'usage: unzip-here ARCHIVE...   (extracts into the current directory)\n' >&2
    exit 2
fi

fail() {
    printf 'unzip-here: %s\n' "$1" >&2
    notify-send "unzip-here" "$1" 2>/dev/null
}

if ! command -v unzip >/dev/null; then
    fail "unzip is not installed"
    exit 1
fi

# Whether the archive already carries a single top-level directory of its own.
#
# If it does, extracting into a directory named after the archive would nest it
# twice -- "project/project/..." -- so it goes straight into the current
# directory. Anything else (loose files at the root, or several top-level
# entries) gets a directory, so Enter on a zip can never scatter files across
# the directory you were looking at.
#
# A single top-level *file* is not self-contained: one entry, no slash, and it
# would land loose. Hence the check for the slash rather than just the count.
self_contained() {
    local names first
    names="$(unzip -Z1 -- "$1" 2>/dev/null)" || return 1
    [ -n "$names" ] || return 1

    first="$(printf '%s\n' "$names" | cut -d/ -f1 | sort -u)"
    [ "$(printf '%s\n' "$first" | wc -l)" -eq 1 ] || return 1

    # Every entry must actually sit under that directory.
    printf '%s\n' "$names" | grep -qv "^${first}/" && return 1
    return 0
}

# A directory that does not exist yet, so a second extract of the same archive
# never merges into the first one's output. -n already stops files being
# clobbered; this stops the two being mixed up at all.
free_dir() {
    local base="$1" n=2
    if [ ! -e "$base" ]; then
        printf '%s\n' "$base"
        return
    fi
    while [ -e "$base-$n" ]; do
        n=$((n + 1))
    done
    printf '%s\n' "$base-$n"
}

status=0

for archive in "$@"; do
    if [ ! -f "$archive" ]; then
        fail "no such file: $archive"
        status=1
        continue
    fi

    name="${archive##*/}"   # strip the directory
    name="${name%.*}"       # and the extension, whatever case it is in

    if self_contained "$archive"; then
        # -n rather than -o: an archive that overlaps what is already here
        # should leave what is here alone, and say so, rather than quietly
        # replacing it.
        if ! unzip -qn -- "$archive" </dev/null; then
            fail "failed to extract $name"
            status=1
        fi
    else
        dir="$(free_dir "$name")"
        if ! unzip -qn -- "$archive" -d "$dir" </dev/null; then
            fail "failed to extract $name"
            status=1
        fi
    fi
done

exit "$status"
