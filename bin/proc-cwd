#!/usr/bin/env bash
# Print the working directory of each process named, one "<pid>\t<cwd>" line
# per pid that still has one.
#
#   proc-cwd 1234 5678
#
# Batched on purpose. The caller is hypr/session.lua, which runs inside the
# compositor and needs this for every window it is about to write down: a
# readlink per window would be a shell per window, and Lua cannot read a
# symlink on its own.
#
# A pid that has gone, or whose /proc entry cannot be read, is skipped rather
# than reported -- the caller has nothing better to do with the failure than
# leave that window's directory out, which is what a missing line means.
#
# For a terminal, this is the wrong directory and bin/terminal-cwd is the right
# one: kitty stays where it was launched while the shell inside it moves. See
# the note there.
#
# `cd -P` rather than `readlink`, for the same reason this is batched at all:
# io.popen blocks the compositor, so every millisecond here is a frozen frame.
# readlink is a program, so it was an exec per pid -- 4ms each, 40ms for a
# snapshot's worth. cd is a builtin, and doing it in this shell rather than in
# `$( )` avoids even the fork: 10 pids cost 4ms, of which 3.8ms is bash
# starting up. A cwd that has been deleted fails the cd and is skipped, which
# is better than readlink's "/gone (deleted)" reaching the session file.
#
# Yes, this leaves the shell sitting in the last directory it looked at.
# Nothing here reads a relative path -- every path below is absolute -- and
# the process exits at the end of the loop.
set -uo pipefail

# A CDPATH inherited from the environment makes `cd` print where it went.
unset CDPATH

if [ $# -eq 0 ]; then
    echo "usage: proc-cwd <pid>..." >&2
    exit 1
fi

for pid in "$@"; do
    cd -P "/proc/$pid/cwd" 2>/dev/null || continue
    printf '%s\t%s\n' "$pid" "$PWD"
done
