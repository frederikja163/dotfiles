#!/usr/bin/env bash
# Open whichever editor suits the desktop's project.
#
# Rider wants a solution or a csproj; everything else gets nvim in a terminal.
# Add a line to the table below to teach it another one.
set -uo pipefail

dir="$(desk-dir)"
cd "$dir" 2>/dev/null || exit 1

shopt -s nullglob

# marker glob -> command
if compgen -G "*.sln" >/dev/null || compgen -G "*.slnx" >/dev/null || compgen -G "*.csproj" >/dev/null; then
    exec desk-run rider .
fi

exec desk-run kitty -e nvim .
