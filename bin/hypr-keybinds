#!/usr/bin/env bash
# Show a searchable list of Hyprland keybinds in fuzzel.
#
# The list is generated from `hyprctl binds`, i.e. from what the compositor has
# actually loaded, so it can never drift out of sync with hypr/hyprland.lua.
# Binds are labelled by their `description` option; any without one are skipped
# (with a Lua config the dispatcher is reported as an opaque "__lua" callback,
# which would be meaningless in a menu).
#
# Deliberately depends on nothing but hyprctl and awk, so it also works on a
# freshly installed machine before any packages are set up.
set -euo pipefail

binds="$(
  hyprctl binds | awk '
    # Hyprland prints one indented "field: value" block per bind.
    /^bind/            { mask = ""; key = ""; desc = ""; submap = ""; next }
    /^\tmodmask:/      { mask = $2; next }
    /^\tkey:/          { key  = $2; next }
    /^\tsubmap:/       {
        # Empty for a normal-mode bind, so this cannot use $2: there is no
        # second field at all on "\tsubmap: ".
        submap = $0
        sub(/^\tsubmap: /, "", submap)
        next
    }
    /^\tdescription:/  {
        # Descriptions contain spaces, so rebuild everything after the colon.
        desc = $0
        sub(/^\tdescription: /, "", desc)
        next
    }
    # A blank line closes the block: emit it if it is usable.
    /^$/ {
        if (desc != "" && key != "") {
            mods = ""
            m = mask + 0
            if (int(m / 64) % 2) mods = mods "SUPER + "
            if (int(m /  8) % 2) mods = mods "ALT + "
            if (int(m /  4) % 2) mods = mods "CTRL + "
            if (int(m /  1) % 2) mods = mods "SHIFT + "

            # A bind inside a mode is not reached by its modifiers -- the mode
            # was entered first -- so it is labelled "<mode> > <key>". The
            # leading field is only there to sort by, and is cut off below:
            # normal mode first, then one group per mode.
            if (submap == "")
                printf "0\t%-30s %s\n", mods key, desc
            else
                printf "1%s\t%-30s %s\n", submap, submap " \342\226\270 " mods key, desc
        }
        mask = ""; key = ""; desc = ""; submap = ""
    }
  ' | sort | cut -f2-
)"

if [ -z "$binds" ]; then
  notify-send "hypr-keybinds" "No binds with descriptions found." 2>/dev/null
  exit 1
fi

# --dmenu reads the options from stdin. Selecting an entry just closes the
# popup; this is a reference list, not an action menu.
#
# --no-run-if-empty guards against an empty list, and the wider window fits the
# "KEYS<pad>Description" layout. fuzzel exits on focus loss by default.
printf '%s\n' "$binds" | fuzzel --dmenu \
  --prompt "keybind  " \
  --width 60 \
  --lines 20 \
  --no-run-if-empty \
  --no-icons >/dev/null
