#!/usr/bin/env bash
# Run waybar on every monitor, the same full bar on each.
#
# waybar has no command line option for the output -- only -b/--bar to pick a
# bar by name -- so the monitor has to come from the config. A config may hold a
# list of bars, so this writes a copy holding one full bar per monitor, each
# with its "output" set to that monitor, and runs waybar against that.
# waybar/config.jsonc itself stays a single machine independent bar, and the
# per-monitor copies are derived from it, so the modules never have to be
# described twice.
#
# If the monitors cannot be worked out, waybar runs against the config as-is,
# which puts the full bar on every monitor: worse, but never no bar at all.
#
# Safe to run repeatedly: it replaces any waybar that is already running.
set -uo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/config.jsonc"
GENERATED="${XDG_RUNTIME_DIR:-/tmp}/waybar-main.jsonc"

# Copy the config into one bar per role, with "output" set. Comments are
# stripped, so the parser has to know not to treat // inside a string as one.
write_config() {
    python3 - "$CONFIG" "$GENERATED" "$1" <<'PY'
import json, sys

src, dst, monitors_raw = sys.argv[1:4]
raw = open(src).read()

out, in_string, escaped, i = [], False, False, 0
while i < len(raw):
    c = raw[i]
    if in_string:
        out.append(c)
        if escaped:
            escaped = False
        elif c == "\\":
            escaped = True
        elif c == '"':
            in_string = False
    elif c == '"':
        in_string = True
        out.append(c)
    elif c == "/" and i + 1 < len(raw) and raw[i + 1] == "/":
        while i < len(raw) and raw[i] != "\n":
            i += 1
        continue
    else:
        out.append(c)
    i += 1

config = json.loads("".join(out))

monitors = json.loads(monitors_raw)

# Skip outputs with no usable mode. A connector can sit in hyprctl as connected
# and not disabled while still reporting 0x0 -- a dock or a cable the kernel
# could not modeset, which shows up as "atomic commit failed" in the Hyprland
# log. Asking for a bar there does not merely fail on that output: waybar's
# layer surface never gets configured, gtk-layer-shell gives up with "Timed out
# waiting for initial .configure", and *every* bar in the process stays
# unmapped. The bar is then running, logging "Bar configured", and invisible on
# all screens -- the worst way to fail, because nothing looks wrong.
monitors = [
    m for m in monitors
    if not m.get("disabled") and m.get("width") and m.get("height")
]

if not monitors:
    sys.exit(1)

# Every monitor gets the same full bar. Each bar is pinned to one output so
# waybar puts a copy on each screen rather than one bar spanning all of them;
# a bar with an empty "output" would land on every monitor anyway, but spelling
# them out keeps each bar on the monitor it is drawn for.
bars = []
for m in monitors:
    bar = dict(config)
    bar["name"] = m["name"]
    bar["output"] = m["name"]
    bars.append(bar)

json.dump(bars, open(dst, "w"), indent=2)
PY
}

# Waybar draws its icons through glycin, which renders every SVG in a bwrap
# sandbox. bwrap refuses to start at all when its caller holds capabilities
# without being setuid -- "Unexpected capabilities but not setuid, old file
# caps config?" -- and this session carries cap_wake_alarm in its ambient set,
# so everything Hyprland starts inherits it. The sandbox therefore never runs,
# no SVG loads, and GTK cannot even load its own image-missing fallback, which
# it treats as a failed assertion and aborts on. The bar dies before it draws,
# which reads as waybar crashing the instant it is opened.
#
# Dropping the capability is the cause, not a workaround: waybar has no use for
# cap_wake_alarm, and without it the sandbox starts and the icons load. Note
# librsvg no longer ships a gdk-pixbuf SVG loader, so there is no non-sandboxed
# path left to fall back to.
#
# Removing the privacy module also stops the crash and was rejected: its icon
# is merely the first SVG the bar happens to load, so that only moves the abort
# to the first tray icon that appears.
waybar_nocaps() {
    exec setpriv --inh-caps=-all --ambient-caps=-all waybar "$@"
}

pkill -x waybar 2>/dev/null
# Give it a moment to release its layer surfaces, or a new bar can land on a
# monitor that is still occupied.
sleep 0.3

monitors="$(hyprctl monitors -j 2>/dev/null)"

if [ -n "$monitors" ] && write_config "$monitors"; then
    waybar_nocaps -c "$GENERATED"
fi

echo "waybar-main: could not read the monitors, showing the full bar on all of them" >&2
waybar_nocaps
