#!/usr/bin/env bash
# Run waybar on every monitor: the full bar on the main one, and a bar carrying
# nothing but the workspaces on each of the others.
#
# "Main" is simply the largest monitor by pixel area. That is deterministic,
# needs no configuration, and does not depend on connector names, which differ
# between machines and even between plug-ins (DP-4 became DP-5 after a redock).
#
# waybar has no command line option for the output -- only -b/--bar to pick a
# bar by name -- so the monitor has to come from the config. A config may hold a
# list of bars, so this writes a copy holding two, each with its "output" filled
# in, and runs waybar against that. waybar/config.jsonc itself stays a single
# machine independent bar, and the second one is derived from it, so the modules
# never have to be described twice.
#
# The workspace module is left to its default of showing only the workspaces of
# the output it is on, which is what makes one config work for every monitor.
#
# If the monitors cannot be worked out, waybar runs against the config as-is,
# which puts the full bar on every monitor: worse, but never no bar at all.
#
# Safe to run repeatedly: it replaces any waybar that is already running.
set -uo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/config.jsonc"
GENERATED="${XDG_RUNTIME_DIR:-/tmp}/waybar-main.jsonc"

# Copy the config into one bar per role, with "output" set. Comments are
# stripped, so the parser has to know not to treat // inside a string as one.
write_config() {
    python3 - "$CONFIG" "$GENERATED" "$1" <<'PY'
import json, sys

src, dst, monitors_raw = sys.argv[1:4]
raw = open(src).read()

out, in_string, escaped, i = [], False, False, 0
while i < len(raw):
    c = raw[i]
    if in_string:
        out.append(c)
        if escaped:
            escaped = False
        elif c == "\\":
            escaped = True
        elif c == '"':
            in_string = False
    elif c == '"':
        in_string = True
        out.append(c)
    elif c == "/" and i + 1 < len(raw) and raw[i + 1] == "/":
        while i < len(raw) and raw[i] != "\n":
            i += 1
        continue
    else:
        out.append(c)
    i += 1

config = json.loads("".join(out))

monitors = json.loads(monitors_raw)
if not monitors:
    sys.exit(1)

# Largest by pixel area is the main one; everything else gets the short bar.
monitors.sort(key=lambda m: m["width"] * m["height"], reverse=True)
main, rest = monitors[0], monitors[1:]

full = dict(config)
full["name"] = "main"
full["output"] = main["name"]
bars = [full]

# Only when there is somewhere to put it. An empty "output" is not the same as
# no bar: waybar reads it as "no restriction" and puts the bar on every monitor.
if rest:
    short = dict(config)
    short["name"] = "secondary"
    short["output"] = [m["name"] for m in rest]
    short["modules-left"] = ["hyprland/workspaces"]
    short["modules-center"] = []
    short["modules-right"] = []
    bars.append(short)

json.dump(bars, open(dst, "w"), indent=2)
PY
}

pkill -x waybar 2>/dev/null
# Give it a moment to release its layer surfaces, or a new bar can land on a
# monitor that is still occupied.
sleep 0.3

monitors="$(hyprctl monitors -j 2>/dev/null)"

if [ -n "$monitors" ] && write_config "$monitors"; then
    exec waybar -c "$GENERATED"
fi

echo "waybar-main: could not read the monitors, showing the full bar on all of them" >&2
exec waybar
