#!/usr/bin/env bash
# Toggle this desktop's dropdown terminal.
#
# Every desktop gets its own, living on a special workspace named after the
# desktop, so it overlays whatever is there and hides again without disturbing
# the columns. It starts in the desktop's directory and carries DESK_ID, so
# cd-ing in it moves the whole desktop (see zsh/.zshrc and bin/desk-dir).
#
# The window is floated and sized by a rule matching its class, see
# hypr/windowrules.lua.
set -uo pipefail

id="$(desk-dir --id)"
[ -n "$id" ] || { echo "desk-quake: no focused desktop" >&2; exit 1; }

special="desk$id"
class="quake-$id"

# hyprctl dispatch takes Lua, because the config is Lua.
dispatch() { hyprctl dispatch "$1" >/dev/null 2>&1; }

exists() {
    hyprctl clients -j 2>/dev/null | python3 -c "
import json, sys
want = sys.argv[1]
print(any(w.get('class') == want for w in json.load(sys.stdin)))
" "$class" 2>/dev/null | grep -q True
}

if exists; then
    dispatch "hl.dsp.workspace.toggle_special(\"$special\")"
    exit 0
fi

# First use on this desktop: start it directly on the special workspace, so it
# never flashes up among the tiled windows.
dir="$(desk-dir)"
dispatch "(function() hl.exec_cmd([[env DESK_ID=$id kitty --class $class --directory $dir]], { workspace = [[special:$special]] }); return hl.dsp.no_op() end)()"

# Show it once it has appeared. Without the wait the toggle can land before the
# window exists and would hide the empty workspace instead.
for _ in $(seq 20); do
    exists && break
    sleep 0.1
done

hyprctl activeworkspace -j 2>/dev/null | grep -q "special:$special" ||
    dispatch "hl.dsp.workspace.toggle_special(\"$special\")"
