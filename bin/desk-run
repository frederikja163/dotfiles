#!/usr/bin/env bash
# Run a command in the focused desktop's directory.
#
#   desk-run kitty
#   desk-run dolphin
#
# Every launcher bind goes through this, so a terminal, a file manager and an
# IDE all open in the project the desktop is currently on.
set -uo pipefail

[ $# -gt 0 ] || { echo "usage: desk-run <command> [args...]" >&2; exit 1; }

dir="$(desk-dir)"
cd "$dir" 2>/dev/null || cd "$HOME" || exit 1

# The desktop id travels with the process, so a shell started this way knows
# which desktop to report its directory to. See the chpwd hook in zsh/.zshrc.
export DESK_ID="${DESK_ID:-$(desk-dir --id)}"

exec "$@"
