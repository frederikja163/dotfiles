# dunst — see dunst(5). Unset options keep their built-in defaults.
# Reload with:  dunstctl reload

[global]
    # Dual monitor: put notifications wherever the keyboard focus is, rather
    # than pinning them to one screen.
    follow = keyboard
    monitor = 0

    # Top right, offset far enough down to clear waybar (34px + 6px margin).
    origin = top-right
    offset = (12, 52)
    width = (250, 450)
    height = (0, 300)
    notification_limit = 5

    # --- appearance ---
    frame_width = 2
    corner_radius = 10
    gap_size = 6
    padding = 12
    horizontal_padding = 14
    transparency = 8

    font = JetBrainsMono Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    word_wrap = yes
    ellipsize = middle

    # --- icons ---
    enable_recursive_icon_lookup = true
    icon_theme = "Papirus-Dark, Adwaita"
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    # --- behaviour ---
    # Volume and brightness keys emit progress hints; dunst renders them as a
    # bar, which replaces the OSD popups KDE used to provide.
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    # Do not cover fullscreen windows: queue notifications until the video,
    # game or Teams screenshare ends.
    fullscreen = pushback

    # Merge duplicate notifications instead of stacking them.
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = false
    sticky_history = yes
    history_length = 25

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

# --- theme: catppuccin mocha ----------------------------------------------

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#585b70"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 10

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    # Never auto-dismiss: critical means it must be acknowledged.
    timeout = 0

# --- rules ------------------------------------------------------------------

# Volume/brightness OSD: transient, no icon clutter, disappears quickly.
[osd]
    appname = "wpctl|brightnessctl|dunstify"
    timeout = 2
    history_ignore = yes

# VPN state changes matter on a work machine.
[vpn-critical]
    appname = "GlobalProtect|NetworkManager"
    urgency = critical
