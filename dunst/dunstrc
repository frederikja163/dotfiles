# dunst — see dunst(5). Unset options keep their built-in defaults.
# Reload with:  dunstctl reload

[global]
    # Dual monitor: the notifications are on the screen you are using, and
    # move with you. dunst draws one popup on one output and cannot show it on
    # all of them, and neither can mako. Mirroring was considered -- a second
    # dunst on a private D-Bus, fed by a script rule -- and passed over,
    # because closing, actions and progress bars would not stay in step.
    #
    # On Wayland this does not mean what dunst(5) says. There is no keyboard
    # focus for dunst to look at: with follow set it asks the compositor for a
    # surface with no output named, and the compositor picks the focused one,
    # once, when the surface is created. keyboard and mouse are the same thing
    # here. Left to itself that strands a notification on the screen it opened
    # on, so lib/dunst-follow, run by hypr/autostart.lua whenever the focused
    # monitor changes, makes dunst create the surface again.
    #
    # A monitor named here was tried instead (monitor = DP-4, follow = none).
    # It cannot be right on more than one machine, and a connector name does
    # not survive a redock -- DP-4 came back as DP-5 -- after which dunst logs
    # "Screen not found" and falls back to the compositor's choice anyway.
    follow = keyboard
    monitor = 0

    # Top right, offset far enough down to clear waybar: 12px of margin plus
    # its 34px height and 6px top margin, from waybar/config.jsonc. Nothing
    # derives this -- the two files agree only because someone keeps them in
    # step -- so a bar that moves, or changes height, wants this changed with
    # it. Dunst is on the `overlay` layer by default, above both the bar and
    # the quake terminal, so it is only the offset that has to be right.
    origin = top-right
    offset = (12, 52)
    width = (250, 450)
    height = (0, 300)
    notification_limit = 5

    # --- appearance ---
    frame_width = 2
    corner_radius = 10
    gap_size = 6
    padding = 12
    horizontal_padding = 14
    transparency = 8

    font = JetBrainsMono Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    word_wrap = yes
    ellipsize = middle

    # --- icons ---
    enable_recursive_icon_lookup = true
    icon_theme = "Papirus-Dark, Adwaita"
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    # --- behaviour ---
    # Volume and brightness keys emit progress hints; dunst renders them as a
    # bar, which replaces the OSD popups KDE used to provide.
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    # Do not cover fullscreen windows: queue notifications until the video,
    # game or Teams screenshare ends.
    fullscreen = pushback

    # Merge duplicate notifications instead of stacking them.
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = false
    sticky_history = yes
    history_length = 25

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

# --- theme: catppuccin mocha ----------------------------------------------

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#585b70"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 10

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    # Never auto-dismiss: critical means it must be acknowledged.
    timeout = 0

# --- rules ------------------------------------------------------------------

# Volume/brightness OSD: transient, no icon clutter, disappears quickly.
[osd]
    appname = "wpctl|brightnessctl|dunstify"
    timeout = 2
    history_ignore = yes

# VPN state changes matter on a work machine.
[vpn-critical]
    appname = "GlobalProtect|NetworkManager"
    urgency = critical

# The dotfiles reminder fires once at login, exactly when you are looking
# somewhere else. It waits to be dismissed rather than the ten seconds an
# ordinary notification gets, since the whole point is to still be there when
# you next look at the screen. Not urgency=critical: it is a reminder to pull,
# not something red.
[dotfiles-update]
    appname = "dotfiles"
    timeout = 0

# GitHub notifications (bin/github-notify) stay until closed, for the same
# reason: they arrive while you are looking at something else, and ten seconds
# is not long enough to see one. Left at urgency normal rather than critical, so
# they keep the blue frame; a burst is already folded into one notice by the
# script, which keeps this from piling up.
[github]
    appname = "github"
    timeout = 0
