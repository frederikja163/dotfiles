# Git — https://git-scm.com/docs/git-config
#
# Lives at ~/.config/git/config rather than ~/.gitconfig, so $HOME stays clean.
# Both are read when both exist, and ~/.gitconfig is read *last* and therefore
# wins, so it must not be left lying around once this is linked.

[core]
	# nvim is the editor here (bob-managed, via PATH); the system default is vim.
	editor = nvim

[user]
	name = FrederikIA
	# GitHub's noreply address rather than a real inbox. It is already in the
	# history of every public repo, and keeps the real address out of it.
	#
	# One identity for work and private alike: same account, same address.
	email = 20968096+frederikja163@users.noreply.github.com

[push]
	# Push a new branch without spelling out --set-upstream first.
	autoSetupRemote = true

[init]
	defaultBranch = main

[diff]
	# Slower than the default, and lines the diff up with what actually
	# changed rather than the first match it finds.
	algorithm = histogram
[pull]
	rebase = false

[credential "https://github.com"]
	# gh is the credential helper for GitHub, so https remotes authenticate with
	# the token setup.sh signs in for. This replaces the ssh key the old setup
	# generated and had the user paste into the account.
	#
	# Written here rather than left to `gh auth setup-git`, which configures the
	# same helper through `git config --global` -- and that writes ~/.gitconfig,
	# the file the header above says must not exist, read last and so winning
	# over this one.
	#
	# The empty value first clears the helper list for this host, which is what
	# setup-git writes: without it a system-level helper (libsecret, store) is
	# consulted first and a stale credential there would win over gh's.
	helper =
	helper = !gh auth git-credential

[alias]
	# `git lines-changed` is bin/lines-changed, so it reads like the rest of git
	# when asked for a PR's size: `git lines-changed --require-clean`.
	#
	# An alias, not a git-lines-changed on PATH, which would work just as well:
	# the launcher keeps its plain name for the places that run it without git
	# (a PR description's instructions, a terminal), and the alias costs a line.
	# Git ignores an alias that shadows one of its own commands, so the name
	# matters: diff-count and diff-lines were passed over because git keeps its
	# diff-* names for plumbing (diff-tree, diff-index, diff-pairs) and could
	# take either one over later without a word.
	lines-changed = !lines-changed
