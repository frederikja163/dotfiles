// Waybar — https://github.com/Alexays/Waybar/wiki/Configuration
//
// One bar, with no "output" key, so it does not depend on monitor names and
// works unchanged on any machine. bin/waybar-main starts it on whichever
// monitor is the main one here; without that it would appear on every monitor.
//
// Reload with:  killall -SIGUSR2 waybar
{
  "name": "main",
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 6,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": [
    "hyprland/workspaces",
    "custom/desk",
    "hyprland/submap"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "privacy",
    "idle_inhibitor",
    "tray",
    "pulseaudio",
    "bluetooth",
    "network",
    "backlight",
    "battery"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "1.1": "1",
      "1.2": "2",
      "1.3": "3",
      "1.4": "4",
      "1.5": "5",
      "1.6": "6",
      "1.7": "7",
      "1.8": "8",
      "1.9": "9",
      "2.1": "1",
      "2.2": "2",
      "2.3": "3",
      "2.4": "4",
      "2.5": "5",
      "2.6": "6",
      "2.7": "7",
      "2.8": "8",
      "2.9": "9",
      "3.1": "1",
      "3.2": "2",
      "3.3": "3",
      "3.4": "4",
      "3.5": "5",
      "3.6": "6",
      "3.7": "7",
      "3.8": "8",
      "3.9": "9",
      "4.1": "1",
      "4.2": "2",
      "4.3": "3",
      "4.4": "4",
      "4.5": "5",
      "4.6": "6",
      "4.7": "7",
      "4.8": "8",
      "4.9": "9"
    }
  },
  "clock": {
    "format": "{:%H:%M  %a %d %b}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1
    }
  },
  "privacy": {
    "icon-size": 14,
    "modules": [
      {
        "type": "screenshare"
      },
      {
        "type": "audio-in"
      }
    ]
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip-format-activated": "Idle inhibited",
    "tooltip-format-deactivated": "Idle normal"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-bluetooth": "{icon} {volume}%",
    "format-icons": {
      "headphone": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-connected": " {num_connections}",
    "tooltip-format-connected": "{device_enumerate}",
    "on-click": "blueman-manager"
  },
  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
    "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
  },
  "battery": {
    "bat": "BAT0",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip-format": "{timeTo} ({power}W)"
  },
  "custom/desk": {
    "exec": "desk-status",
    "interval": 2,
    "format": "  {}",
    "tooltip": false,
    "max-length": 40
  }
}
