// Waybar — https://github.com/Alexays/Waybar/wiki/Configuration
//
// One bar, with no "output" key, so it does not depend on monitor names and
// works unchanged on any machine. bin/waybar-main copies it into one full bar
// per monitor, each pinned to its own output -- so the same complete bar shows
// on every screen. Describing the modules once here is the point; the
// per-monitor copies are derived, never written out again.
//
// On the "bottom" layer, not "top", and that is the whole reason the quake
// terminal can share this edge.
//
// Hyprland renders background -> bottom -> windows -> top -> overlay, so a
// bar on "top" is drawn above every window, floating ones included. It
// therefore won the top edge outright: the quake terminal is flush to y=0 by
// design (hypr/quake.lua) and had its first 40px painted over, and the bar
// swallowed the pointer events there too. On "bottom" the terminal draws over
// the bar instead, which is exactly the drop-down console behaviour that file
// is written around.
//
// The bar does not disappear the rest of the time, because "layer" and the
// exclusive zone are independent: this bar still reserves its 40px, so no
// *tiled* window is ever placed over it and there is nothing to hide it. What
// can cover it is a floating window in the top 40px -- in this config that is
// the quake terminal, deliberately -- and a fullscreen window, which would
// cover a "top" bar as well.
//
// Two edges were tried first and rejected. Moving the bar to the bottom
// worked and was disliked on sight. Pushing the terminal down to the bottom
// worked too -- hl.get_active_monitor().reserved gives the exclusive zone as
// {top,bottom,left,right} in layout pixels, so quake.lua's fit() could dodge
// whatever the bar reserves with no height copied between the two files --
// and was disliked for the same reason: the console belongs at the top.
//
// One thing outside waybar is not derived: dunst/dunstrc offsets its
// notifications down past this bar, and that number is written by hand.
//
// Reload with:  killall -SIGUSR2 waybar
{
  "name": "main",
  "layer": "bottom",
  "position": "top",
  "height": 34,
  "spacing": 6,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "mpris",
    "privacy",
    "idle_inhibitor",
    "tray",
    "pulseaudio",
    "bluetooth",
    "network",
    "backlight",
    "battery"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    // Waybar orders buttons by workspace id unless told otherwise, and the id
    // is not the order the desktops are in: shuffling one along its row
    // (SUPER+CTRL+M then h/l) deliberately leaves the id alone, so the bar
    // ignored the move completely. Sorting by name follows the row, because
    // deskbinds.lua names every desktop with its own number first.
    //
    // Sorting is lexicographic (workspaces.cpp compares the names directly),
    // which is why the number has to lead and why a tenth desktop on one
    // screen would sort between the first and the second. Nine per screen is
    // already more than the number keys address.
    "sort-by": "name",
    // Desktop names are "<screen>.<desktop>" only when nothing has labelled
    // them, and this maps those to the bare desktop number. In practice it
    // never fires: quake.lua labels every desktop after its terminal's
    // directory ("~" when it has not been taken anywhere), so what you see is
    // the name itself -- "2 dotfiles", numbered by deskbinds.lua. Kept as the
    // fallback for a config without that labeller.
    "format-icons": {
      "1.1": "1",
      "1.2": "1",
      "1.3": "1",
      "1.4": "1",
      "2.1": "2",
      "2.2": "2",
      "2.3": "2",
      "2.4": "2",
      "3.1": "3",
      "3.2": "3",
      "3.3": "3",
      "3.4": "3",
      "4.1": "4",
      "4.2": "4",
      "4.3": "4",
      "4.4": "4",
      "5.1": "5",
      "5.2": "5",
      "5.3": "5",
      "5.4": "5",
      "6.1": "6",
      "6.2": "6",
      "6.3": "6",
      "6.4": "6",
      "7.1": "7",
      "7.2": "7",
      "7.3": "7",
      "7.4": "7",
      "8.1": "8",
      "8.2": "8",
      "8.3": "8",
      "8.4": "8",
      "9.1": "9",
      "9.2": "9",
      "9.3": "9",
      "9.4": "9"
    }
  },
  // Which keybind mode is active, from hypr/modes.lua. Empty outside a mode,
  // and Waybar hides a module with no text, so the bar is unchanged until you
  // enter one. This is the only thing that says a sticky mode is still on --
  // size mode is left by Escape, so being able to see it matters.
  "hyprland/submap": {
    "format": "  {}",
    "tooltip": false
  },
  "clock": {
    "format": "{:%H:%M  %a %d %b}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1
    }
  },
  // What is playing, first in the right-hand group so it reads as the leftmost
  // of the status pills. There is no text when nothing is playing and Waybar
  // hides a module with no text, so the bar is unchanged until a player
  // appears, the same way the submap on the left stays invisible.
  //
  // It sat on the left, after the desktops, and moved here: a title changing
  // length every few minutes was shoving the workspace pills sideways, because
  // the left group grows rightwards from a fixed edge. In the right-hand group
  // the growth is absorbed at the group's own left edge, so the icons at the
  // far end -- the ones read by position rather than by looking -- hold still.
  //
  // This is the built-in mpris module rather than a custom module polling mpv's
  // --input-ipc-server socket. mpv speaks no MPRIS by itself: it sits on the
  // session bus, put there by its audio backend, and never claims an
  // org.mpris.MediaPlayer2 name, which is why playerctl listed firefox and not
  // a running, audible mpv. mpv-mpris is what gives it the name, and that one
  // package buys more than a script would -- the XF86Audio binds in
  // hypr/keybinds.lua already drive playerctl, so they started controlling mpv
  // the moment it was installed. The IPC script was rejected twice over: it
  // would read mpv and nothing else, and it would leave those four binds dead.
  //
  // No "player" key, so this follows whatever is playing -- mpv, a browser tab,
  // anything that registers. Pinning it to mpv was considered and is the
  // smaller feature for the same work.
  //
  // dynamic-len truncates on a character boundary, which is why style.css sets
  // no max-width on the pill: clipping it in CSS cuts a glyph in half instead.
  // The untruncated text is in the tooltip. Titles come from the file's tags
  // when it has them and the filename when it does not, which is why the
  // Pixabay downloads show as their slug while bin/music-get's show as artist
  // and title.
  "mpris": {
    "format": "{status_icon} {dynamic}",
    "format-stopped": "",
    "dynamic-order": [
      "title",
      "artist"
    ],
    "dynamic-separator": "  ·  ",
    "dynamic-len": 40,
    "status-icons": {
      "playing": "",
      "paused": ""
    },
    "tooltip-format": "{status_icon}  {title}\n{artist}\n{album}\n\n{player}  {position}/{length}",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "privacy": {
    "icon-size": 14,
    "modules": [
      {
        "type": "screenshare"
      },
      {
        "type": "audio-in"
      }
    ]
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip-format-activated": "Idle inhibited",
    "tooltip-format-deactivated": "Idle normal"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-bluetooth": "{icon} {volume}%",
    "format-icons": {
      "headphone": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-connected": " {num_connections}",
    "tooltip-format-connected": "{device_enumerate}",
    "on-click": "blueman-manager"
  },
  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
    "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
  },
  "battery": {
    "bat": "BAT0",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip-format": "{timeTo} ({power}W)"
  }
}
